<#
.SYNOPSIS
    PowerShell language and object utilities for the CharlandCustomizations module.

.DESCRIPTION
    Nested module providing general-purpose PowerShell helpers that are not tied to a
    specific AWS service. The functions here smooth over common friction points when
    working with objects and the pipeline.

    Exported functions:
        ConvertTo-CHARHashtable - Converts a PSCustomObject into an ordered hashtable
                                  suitable for splatting.

.NOTES
    Generated by Kiro using Claude Opus 4.8, reviewed by ccharland

    Requires PowerShell 7.2+.
    Loaded as a nested module via the CharlandCustomizations manifest NestedModules list.
#>


function ConvertTo-CHARHashtable {
    <#
    .SYNOPSIS
        Converts a PSCustomObject into an ordered hashtable suitable for splatting.

    .DESCRIPTION
        Transforms PSCustomObject instances into ordered hashtables so their properties
        can be splatted against a cmdlet's parameters using the @variable operator. This
        addresses the common friction point where pipeline-produced PSCustomObjects cannot
        be splatted directly.

        Property order from the source object is preserved. Property values are copied by
        reference without type conversion, so the value types in the resulting hashtable
        match the original object's property types.

        Supports inclusion filtering (-Property), exclusion filtering (-ExcludeProperty),
        and optional recursive conversion of nested PSCustomObject values (-Depth).

    .PARAMETER InputObject
        The PSCustomObject to convert. Accepts pipeline input by value. A $null value
        produces a warning and no output; a non-PSCustomObject value produces a
        non-terminating error and processing continues with the next pipeline item.

    .PARAMETER Property
        Optional list of property names to include. Matching is case-insensitive; the
        original source-object casing is preserved for the resulting hashtable keys. Names
        that do not exist on the source object are silently ignored. An empty array yields
        an empty hashtable.

    .PARAMETER ExcludeProperty
        Optional list of property names to omit. Matching is case-insensitive exact-string
        (no wildcard expansion) and is applied after -Property filtering. Names that match
        nothing are silently ignored.

    .PARAMETER Depth
        Maximum recursion depth for nested PSCustomObject values. Defaults to 1 (shallow;
        nested objects are left as-is). A value greater than 1 recursively converts nested
        PSCustomObject values, one level per depth, up to the specified limit. Arrays,
        hashtables, and primitive values are always passed through unconverted.

    .EXAMPLE
        $obj = [pscustomobject]@{ Name = 'web-1'; InstanceType = 't3.micro' }
        $splat = $obj | ConvertTo-CHARHashtable
        New-EC2Instance @splat

        Converts the object to a hashtable and splats it against a cmdlet.

    .EXAMPLE
        Get-Item .\file.txt | ConvertTo-CHARHashtable -Property Name, Length

        Returns an ordered hashtable containing only the Name and Length keys.

    .EXAMPLE
        $config | ConvertTo-CHARHashtable -Depth 2

        Recursively converts nested PSCustomObject values one level deep.

    .OUTPUTS
        System.Collections.Specialized.OrderedDictionary

    .NOTES
        Generated by Kiro using Claude Opus 4.8, reviewed by ccharland
    #>
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param(
        [Parameter(ValueFromPipeline = $true)]
        [object] $InputObject,

        [Parameter()]
        [string[]] $Property,

        [Parameter()]
        [string[]] $ExcludeProperty,

        [Parameter()]
        [ValidateRange(1, 100)]
        [int] $Depth = 1
    )

    process {
        # A $null pipeline item is not an error, but there is nothing to convert.
        if ($null -eq $InputObject) {
            Write-Warning 'ConvertTo-CHARHashtable: InputObject is null; no output produced.'
            return
        }

        # Reject anything that is not a PSCustomObject with a non-terminating error so a
        # single bad item does not abort a larger pipeline.
        if ($InputObject -isnot [System.Management.Automation.PSCustomObject]) {
            $actualType = $InputObject.GetType().FullName
            Write-Error "ConvertTo-CHARHashtable: expected a PSCustomObject but received [$actualType]. Skipping this item."
            return
        }

        $sourceProperties = @($InputObject.psobject.Properties)
        Write-Verbose "ConvertTo-CHARHashtable: converting object with $($sourceProperties.Count) propertie(s)."

        # -Property is an explicit inclusion allow-list. When supplied (even as an empty
        # array), only names present in it are considered. Comparison is case-insensitive,
        # but we keep the source object's original casing for the emitted keys.
        if ($PSBoundParameters.ContainsKey('Property')) {
            $includeLookup = @{}
            foreach ($name in $Property) { $includeLookup[$name] = $true }
            $selected = $sourceProperties | Where-Object {
                $includeLookup.ContainsKey($_.Name)
            }
        } else {
            $selected = $sourceProperties
        }

        # -ExcludeProperty removes names from whatever survived the inclusion filter.
        if ($PSBoundParameters.ContainsKey('ExcludeProperty') -and $ExcludeProperty.Count -gt 0) {
            $excludeLookup = @{}
            foreach ($name in $ExcludeProperty) { $excludeLookup[$name] = $true }
            $selected = $selected | Where-Object {
                -not $excludeLookup.ContainsKey($_.Name)
            }
        }

        $result = [ordered]@{}
        foreach ($prop in $selected) {
            $value = $prop.Value

            # Only nested PSCustomObjects recurse, and only while depth budget remains.
            # Everything else (arrays, hashtables, primitives) passes through untouched.
            if ($Depth -gt 1 -and $value -is [System.Management.Automation.PSCustomObject]) {
                $value = ConvertTo-CHARHashtable -InputObject $value -Depth ($Depth - 1)
            }

            $result[$prop.Name] = $value
        }

        $result
    }
}

# Export functions
Export-ModuleMember -Function @(
    'ConvertTo-CHARHashtable'
)
