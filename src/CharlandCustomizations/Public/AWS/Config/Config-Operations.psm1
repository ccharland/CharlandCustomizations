            PrincipalName              = $principalName
            FirstCloudTrailEventName   = $eventName
            FirstCloudTrailEventSource = $eventSource
        }
    }

    end { }
}

function Get-CHARConfigNonCompliantResource {
    <#
    .SYNOPSIS
        Retrieves all non-compliant resources for a specified AWS Config rule.

    .DESCRIPTION
        Queries AWS Config for all resources evaluated as non-compliant by the
        specified Config rule. Returns a collection of PSCustomObjects containing
        the resource identifier, resource type, compliance status, and rule name.

        When the Config rule has no non-compliant resources, writes a verbose
        message indicating full compliance and returns an empty collection.

    .PARAMETER ConfigRuleName
        The name of the AWS Config rule to query for non-compliant resources.

    .PARAMETER Region
        AWS region override. If not specified, uses the default session region.

    .PARAMETER ProfileName
        AWS credential profile name.

    .PARAMETER AccessKey
        AWS IAM access key for explicit credentials.

    .PARAMETER SecretKey
        AWS IAM secret key for explicit credentials.

    .PARAMETER SessionToken
        AWS session token for temporary credentials.

    .PARAMETER Credential
        Pre-built AWS credential object (AWSCredentials).

    .PARAMETER ProfileLocation
        Path to a custom AWS credential file.

    .PARAMETER EndpointUrl
        Custom AWS service endpoint URL.

    .EXAMPLE
        Get-CHARConfigNonCompliantResource -ConfigRuleName 's3-bucket-versioning-enabled' -Region 'us-east-1'

        Retrieves all S3 buckets that are non-compliant with the versioning rule.

    .EXAMPLE
        'ec2-instance-managed-by-ssm' | Get-CHARConfigNonCompliantResource -ProfileName 'prod'

        Accepts the Config rule name from pipeline input and queries non-compliant resources using the 'prod' profile.

    .NOTES
        Generated by Kiro using Claude Sonnet 4, reviewed by ccharland
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUsePSCredentialType', '',
        Justification = 'AWS functions use Amazon.Runtime.AWSCredentials, not PSCredential')]
    param(
        [Parameter(Mandatory, ValueFromPipeline, ValueFromPipelineByPropertyName)]
        [ValidateNotNullOrEmpty()]
        [string]$ConfigRuleName,

        # AWS common parameters
        [Parameter()]
        [string]$Region,

        [Parameter()]
        [string]$ProfileName,

        [Parameter()]
        [string]$AccessKey,

        [Parameter()]
        [string]$SecretKey,

        [Parameter()]
        [string]$SessionToken,

        [Parameter()]
        [object]$Credential,

        [Parameter()]
        [string]$ProfileLocation,

        [Parameter()]
        [string]$EndpointUrl
    )

    begin {
        @('Get-CFGComplianceDetailsByConfigRule') | Test-CHARAWSCmdlet | Out-Null

        $ErrorActionPreference = 'Stop'
        $awsParams = New-AWSParamSplat -BoundParameters $PSBoundParameters
    }

    process {
        Write-Verbose "Querying non-compliant resources for Config rule '$ConfigRuleName'."

        try {
            $results = Get-CFGComplianceDetailsByConfigRule -ConfigRuleName $ConfigRuleName -ComplianceType NON_COMPLIANT @awsParams
        }
        catch {
            if ($_.Exception.GetType().Name -eq 'NoSuchConfigRuleException') {
                Write-Error "Config rule '$ConfigRuleName' does not exist in this account/region."
                return
            }
            $errorMessage = $_.Exception.Message
            if ($errorMessage -match 'AccessDenied|not authorized') {
                Write-Error "Access denied querying compliance for rule '$ConfigRuleName': $errorMessage"
            }
            else {
                Write-Error "AWS Config API error for rule '$ConfigRuleName': $errorMessage"
            }
            return
        }

        if (-not $results -or $results.Count -eq 0) {
            Write-Verbose "Config rule '$ConfigRuleName' has no non-compliant resources. All resources are compliant."
            return
        }

        Write-Verbose "Found $($results.Count) non-compliant resource(s) for rule '$ConfigRuleName'."

        foreach ($result in $results) {
            [PSCustomObject][ordered]@{
                ResourceId     = $result.EvaluationResultIdentifier.EvaluationResultQualifier.ResourceId
                ResourceType   = $result.EvaluationResultIdentifier.EvaluationResultQualifier.ResourceType
                ComplianceType = $result.ComplianceType
                ConfigRuleName = $ConfigRuleName
            }
        }
    }

    end { }
}

function Get-CHARConfigResourceComplianceReport {
    <#
    .SYNOPSIS
        Retrieves all AWS Config rule compliance evaluations for a specific resource.

    .DESCRIPTION
        Queries AWS Config for all compliance evaluation results associated with a
        specified resource. Returns an object per Config rule evaluation showing the
        rule name, compliance status, and when the evaluation last occurred.

        Use this function to assess the overall compliance posture of an individual
        resource across all Config rules that evaluate it.

    .PARAMETER ResourceId
        The unique identifier of the AWS resource to query (e.g., i-0123456789abcdef0).

    .PARAMETER ResourceType
        The AWS Config resource type (e.g., AWS::EC2::Instance, AWS::S3::Bucket).

    .PARAMETER Region
        AWS region override. If not specified, uses the default session region.

    .PARAMETER ProfileName
        AWS credential profile name.

    .PARAMETER AccessKey
        AWS IAM access key for explicit credentials.

    .PARAMETER SecretKey
        AWS IAM secret key for explicit credentials.

    .PARAMETER SessionToken
        AWS session token for temporary credentials.

    .PARAMETER Credential
        Pre-built AWS credential object (AWSCredentials).

    .PARAMETER ProfileLocation
        Path to a custom AWS credential file.

    .PARAMETER EndpointUrl
        Custom AWS service endpoint URL.

    .EXAMPLE
        Get-CHARConfigResourceComplianceReport -ResourceId 'i-0123456789abcdef0' -ResourceType 'AWS::EC2::Instance' -Region 'us-east-1'

        Retrieves all Config rule evaluations for the specified EC2 instance.

    .EXAMPLE
        'i-0123456789abcdef0' | Get-CHARConfigResourceComplianceReport -ResourceType 'AWS::EC2::Instance'

        Accepts the resource ID from pipeline input and retrieves its compliance report.

    .NOTES
        Generated by Kiro using Claude Sonnet 4, reviewed by ccharland
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUsePSCredentialType', '',
        Justification = 'AWS functions use Amazon.Runtime.AWSCredentials, not PSCredential')]
    param(
        [Parameter(Mandatory, ValueFromPipeline, ValueFromPipelineByPropertyName)]
        [ValidateNotNullOrEmpty()]
        [string]$ResourceId,

        [Parameter(Mandatory, ValueFromPipelineByPropertyName)]
        [ValidateNotNullOrEmpty()]
        [string]$ResourceType,

        # AWS common parameters
        [Parameter()]
        [string]$Region,

        [Parameter()]
        [string]$ProfileName,

        [Parameter()]
        [string]$AccessKey,

        [Parameter()]
        [string]$SecretKey,

        [Parameter()]
        [string]$SessionToken,

        [Parameter()]
        [object]$Credential,

        [Parameter()]
        [string]$ProfileLocation,

        [Parameter()]
        [string]$EndpointUrl
    )

    begin {
        @('Get-CFGComplianceDetailsByResource') | Test-CHARAWSCmdlet | Out-Null

        $ErrorActionPreference = 'Stop'
        $awsParams = New-AWSParamSplat -BoundParameters $PSBoundParameters
    }

    process {
        # Validate and correct ResourceType
        $validatedType = Test-CHARConfigResourceType -ResourceType $ResourceType @awsParams
        if ($validatedType -eq $false) {
            Write-Error "Invalid resource type '$ResourceType' — could not be corrected to a valid AWS Config resource type." -ErrorAction Stop
            return
        }
        if ($validatedType -ne $ResourceType) {
            Write-Verbose "Corrected ResourceType from '$ResourceType' to '$validatedType'."
            $ResourceType = $validatedType
        }

        Write-Verbose "Querying AWS Config compliance evaluations for resource '$ResourceId' ($ResourceType)."

        try {
            $evaluations = Get-CFGComplianceDetailsByResource -ResourceId $ResourceId -ResourceType $ResourceType @awsParams
        }
        catch {
            $errorMessage = $_.Exception.Message
            if ($errorMessage -match 'AccessDenied|not authorized') {
                Write-Error "Access denied querying compliance details for '$ResourceId': $errorMessage"
            }
            else {
                Write-Error "AWS Config API error for '$ResourceId': $errorMessage"
            }
            return
        }

        if (-not $evaluations -or $evaluations.Count -eq 0) {
            Write-Warning "Resource '$ResourceId' ($ResourceType) has no Config rule evaluations."
            return
        }

        Write-Verbose "Found $($evaluations.Count) compliance evaluation(s) for '$ResourceId'."

        foreach ($result in $evaluations) {
            [PSCustomObject][ordered]@{
                ResourceId        = $ResourceId
                ResourceType      = $ResourceType
                ConfigRuleName    = $result.EvaluationResultIdentifier.EvaluationResultQualifier.ConfigRuleName
                ComplianceType    = $result.ComplianceType
                LastEvaluatedTime = $result.ResultRecordedTime
            }
        }
    }

    end { }
}
