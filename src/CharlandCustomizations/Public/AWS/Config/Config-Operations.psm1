<#
.SYNOPSIS
    AWS Config resource lifecycle and compliance query functions.

.DESCRIPTION
    Provides functions to query resource creation/deletion dates with
    CloudTrail event correlation, retrieve non-compliant resources for
    Config rules, and generate per-resource compliance reports.

.NOTES
    Generated by Kiro using Claude Sonnet 4, reviewed by ccharland
#>

# Load private helper functions needed by this nested module
. "$PSScriptRoot/../../../Private/New-AWSParamSplat.ps1"
. "$PSScriptRoot/../../Test-CHARAWSCmdlet.ps1"

# Module-scoped cache for validated AWS Config resource types (lazy-loaded on first use)
$script:ConfigResourceTypeCache = $null

function Test-CHARConfigResourceType {
    <#
    .SYNOPSIS
        Validates and corrects AWS Config resource type strings.

    .DESCRIPTION
        Implements a correction-first validation pipeline for AWS Config resource
        type strings. Rather than simply rejecting malformed input, it attempts to
        fix common mistakes (casing, separators, missing prefix) before returning
        $false for unfixable input.

        The correction pipeline applies in order: trim whitespace, normalize single-
        colon separators to double-colon, prepend AWS:: prefix if missing, PascalCase
        each segment, then validate the result against the structural format pattern.

        When a dynamically cached list of known resource types is available (fetched
        from the AWS Config API on first use), the validator also catches typos that
        pass structural checks but don't correspond to real AWS Config resource types.

        The function never throws terminating errors for invalid input. It always
        returns either a corrected resource type string or $false.

    .PARAMETER ResourceType
        The AWS Config resource type string to validate and correct. Accepts pipeline
        input. May be $null or empty (returns $false).

    .PARAMETER RefreshCache
        Forces the validator to discard the cached resource type list and re-fetch
        from the AWS Config API regardless of current cache state.

    .PARAMETER Region
        AWS region override for cache population API call.

    .PARAMETER ProfileName
        AWS credential profile name for cache population API call.

    .PARAMETER AccessKey
        AWS IAM access key for cache population API call.

    .PARAMETER SecretKey
        AWS IAM secret key for cache population API call.

    .PARAMETER SessionToken
        AWS session token for cache population API call.

    .PARAMETER Credential
        Pre-built AWS credential object (AWSCredentials) for cache population API call.

    .PARAMETER ProfileLocation
        Path to a custom AWS credential file for cache population API call.

    .PARAMETER EndpointUrl
        Custom AWS service endpoint URL for cache population API call.

    .INPUTS
        [string] Resource type string via pipeline (ValueFromPipeline, ValueFromPipelineByPropertyName).

    .OUTPUTS
        [object] Returns the corrected resource type string on success, or $false
        when the input cannot be corrected to a valid format or does not match a
        known resource type in the cache.

    .EXAMPLE
        Test-CHARConfigResourceType -ResourceType 'aws::ec2::instance'

        Returns 'AWS::EC2::Instance' (corrected via cache lookup or PascalCase).

    .EXAMPLE
        'EC2::Instance', 'S3::Bucket', 'InvalidType' | Test-CHARConfigResourceType

        Pipes multiple values through the validator. Returns corrected strings for
        valid inputs and $false for unfixable inputs, one result per input.

    .EXAMPLE
        Test-CHARConfigResourceType -ResourceType 'AWS:EC2:Instance'

        Returns 'AWS::EC2::Instance' after normalizing single-colon separators.

    .NOTES
        Generated by Kiro using Claude Sonnet 4, reviewed by ccharland

    .LINK
        https://docs.aws.amazon.com/config/latest/developerguide/resource-config-reference.html
    #>
    [CmdletBinding()]
    [OutputType([object])]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUsePSCredentialType', '',
        Justification = 'AWS functions use Amazon.Runtime.AWSCredentials, not PSCredential')]
    param(
        [Parameter(Mandatory, ValueFromPipeline, ValueFromPipelineByPropertyName)]
        [AllowNull()]
        [AllowEmptyString()]
        [string]$ResourceType,

        [Parameter()]
        [switch]$RefreshCache,

        # AWS common parameters (used only for cache population)
        [Parameter()]
        [string]$Region,

        [Parameter()]
        [string]$ProfileName,

        [Parameter()]
        [string]$AccessKey,

        [Parameter()]
        [string]$SecretKey,

        [Parameter()]
        [string]$SessionToken,

        [Parameter()]
        [object]$Credential,

        [Parameter()]
        [string]$ProfileLocation,

        [Parameter()]
        [string]$EndpointUrl
    )

    begin {
        $awsParams = New-AWSParamSplat -BoundParameters $PSBoundParameters

        # Populate or refresh the resource type cache once per pipeline invocation
        if ($null -eq $script:ConfigResourceTypeCache -or $RefreshCache) {
            try {
                @('Get-CFGDiscoveredResourceCount') | Test-CHARAWSCmdlet | Out-Null
                $results = Get-CFGDiscoveredResourceCount @awsParams
                $script:ConfigResourceTypeCache = @($results | Select-Object -ExpandProperty ResourceType -Unique | Sort-Object)
                Write-Verbose "Populated Config resource type cache with $($script:ConfigResourceTypeCache.Count) types."
            }
            catch {
                Write-Warning "Could not populate AWS Config resource type cache: $($_.Exception.Message). Falling back to format-only validation."
                $script:ConfigResourceTypeCache = @()
            }
        }
    }

    process {
        $formatPattern = '^AWS::[A-Z][a-zA-Z0-9]+::[A-Z][a-zA-Z0-9]+$'

        # Stage 0: Handle $null, empty, or whitespace-only input
        if ([string]::IsNullOrWhiteSpace($ResourceType)) {
            return $false
        }

        # Stage 1: Trim leading/trailing whitespace
        $value = $ResourceType.Trim()

        # Stage 2: Normalize separators — replace single colons (not part of ::) with ::
        $value = $value -replace '(?<!:):(?!:)', '::'

        # Stage 3: Prepend AWS:: prefix if missing (case-insensitive check)
        if ($value -notmatch '^AWS::') {
            # Also handle case where input starts with aws:: in wrong case
            if ($value -match '^[Aa][Ww][Ss]::') {
                # Already has the prefix in wrong case — will be fixed by PascalCase step
            }
            else {
                $value = "AWS::$value"
            }
        }

        # Stage 4: PascalCase each segment
        $segments = $value -split '::'

        # Force first segment to literal 'AWS'
        $segments[0] = 'AWS'

        for ($i = 1; $i -lt $segments.Length; $i++) {
            if ($segments[$i].Length -gt 0) {
                $segments[$i] = $segments[$i].Substring(0, 1).ToUpper() + $segments[$i].Substring(1)
            }
        }

        $value = $segments -join '::'

        # Stage 4b: Apply well-known AWS service abbreviation corrections
        # PascalCase alone produces 'Ec2', 'Rds', etc. — fix common all-caps service names
        # that can't be inferred from simple first-char uppercase logic.
        $knownAbbreviations = @{
            'Ec2'          = 'EC2'
            'Rds'          = 'RDS'
            'Iam'          = 'IAM'
            'Elb'          = 'ELB'
            'Elbv2'        = 'ELBv2'
            'Ecs'          = 'ECS'
            'Eks'          = 'EKS'
            'Emr'          = 'EMR'
            'Kms'          = 'KMS'
            'Sns'          = 'SNS'
            'Sqs'          = 'SQS'
            'Ssm'          = 'SSM'
            'Waf'          = 'WAF'
            'Wafv2'        = 'WAFv2'
            'Dms'          = 'DMS'
            'Acm'          = 'ACM'
            'Ecr'          = 'ECR'
        }
        $correctedSegments = $value -split '::'
        for ($j = 1; $j -lt $correctedSegments.Length; $j++) {
            if ($knownAbbreviations.ContainsKey($correctedSegments[$j])) {
                $correctedSegments[$j] = $knownAbbreviations[$correctedSegments[$j]]
            }
        }
        $value = $correctedSegments -join '::'

        # Stage 5: Validate against the structural format pattern
        if ($value -notmatch $formatPattern) {
            return $false
        }

        # Stage 6: Enum validation via cache
        if ($script:ConfigResourceTypeCache.Count -gt 0) {
            # Exact case-sensitive match
            if ($value -cin $script:ConfigResourceTypeCache) {
                return $value
            }

            # Case-insensitive match
            $caseMatches = @($script:ConfigResourceTypeCache | Where-Object { $_ -ieq $value })

            if ($caseMatches.Count -eq 1) {
                return $caseMatches[0]
            }

            # Zero matches or ambiguous (2+) — return $false
            return $false
        }

        # Cache empty (API failed or not available) — format-only mode
        return $value
    }

    end { }
}

function Get-CHARConfigResourceCreationDate {
    <#
    .SYNOPSIS
        Determines when an AWS resource was first recorded by AWS Config.

    .DESCRIPTION
        Queries AWS Config resource history to identify the earliest recorded
        configuration item for a specified resource. When a creation record is
        found, correlates with CloudTrail to identify the IAM principal and API
        event that created the resource.

        Returns a PSCustomObject with the resource identifier, creation date,
        and CloudTrail event details. When CloudTrail data is unavailable, the
        correlation fields are set to $null.

    .PARAMETER ResourceId
        The unique identifier of the AWS resource to query (e.g., i-0123456789abcdef0).

    .PARAMETER ResourceType
        The AWS Config resource type (e.g., AWS::EC2::Instance, AWS::S3::Bucket).

    .PARAMETER Region
        AWS region override. If not specified, uses the default session region.

    .PARAMETER ProfileName
        AWS credential profile name.

    .PARAMETER AccessKey
        AWS IAM access key for explicit credentials.

    .PARAMETER SecretKey
        AWS IAM secret key for explicit credentials.

    .PARAMETER SessionToken
        AWS session token for temporary credentials.

    .PARAMETER Credential
        Pre-built AWS credential object (AWSCredentials).

    .PARAMETER ProfileLocation
        Path to a custom AWS credential file.

    .PARAMETER EndpointUrl
        Custom AWS service endpoint URL.

    .EXAMPLE
        Get-CHARConfigResourceCreationDate -ResourceId 'i-0123456789abcdef0' -ResourceType 'AWS::EC2::Instance' -Region 'us-east-1'

        Queries the creation date and creating principal for the specified EC2 instance.

    .EXAMPLE
        'i-0123456789abcdef0' | Get-CHARConfigResourceCreationDate -ResourceType 'AWS::EC2::Instance'

        Accepts the resource ID from pipeline input and queries its creation history.

    .NOTES
        Generated by Kiro using Claude Sonnet 4, reviewed by ccharland
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUsePSCredentialType', '',
        Justification = 'AWS functions use Amazon.Runtime.AWSCredentials, not PSCredential')]
    param(
        [Parameter(Mandatory, ValueFromPipeline, ValueFromPipelineByPropertyName)]
        [ValidateNotNullOrEmpty()]
        [string]$ResourceId,

        [Parameter(Mandatory, ValueFromPipelineByPropertyName)]
        [ValidateNotNullOrEmpty()]
        [string]$ResourceType,

        # AWS common parameters
        [Parameter()]
        [string]$Region,

        [Parameter()]
        [string]$ProfileName,

        [Parameter()]
        [string]$AccessKey,

        [Parameter()]
        [string]$SecretKey,

        [Parameter()]
        [string]$SessionToken,

        [Parameter()]
        [object]$Credential,

        [Parameter()]
        [string]$ProfileLocation,

        [Parameter()]
        [string]$EndpointUrl
    )

    begin {
        @('Get-CFGResourceConfigHistory', 'Find-CTEvent') | Test-CHARAWSCmdlet | Out-Null

        $ErrorActionPreference = 'Stop'
        $awsParams = New-AWSParamSplat -BoundParameters $PSBoundParameters
    }

    process {
        # Validate and correct ResourceType
        $validatedType = Test-CHARConfigResourceType -ResourceType $ResourceType @awsParams
        if ($validatedType -eq $false) {
            Write-Error "Invalid resource type '$ResourceType' — could not be corrected to a valid AWS Config resource type." -ErrorAction Stop
            return
        }
        if ($validatedType -ne $ResourceType) {
            Write-Verbose "Corrected ResourceType from '$ResourceType' to '$validatedType'."
            $ResourceType = $validatedType
        }

        Write-Verbose "Querying AWS Config history for resource '$ResourceId' ($ResourceType)."

        try {
            $history = Get-CFGResourceConfigHistory -ResourceId $ResourceId -ResourceType $ResourceType -ChronologicalOrder Forward @awsParams -Limit 5 |Select-Object -First 2
        }
        catch {
            if ($_.Exception.GetType().Name -eq 'ResourceNotDiscoveredException') {
                Write-Warning "Resource '$ResourceId' ($ResourceType) has no configuration history in AWS Config."
                return $null
            }
            $errorMessage = $_.Exception.Message
            if ($errorMessage -match 'AccessDenied|not authorized') {
                Write-Error "Access denied querying Config history for '$ResourceId': $errorMessage"
            }
            else {
                Write-Error "AWS Config API error for '$ResourceId': $errorMessage"
            }
            return
        }

        if (-not $history -or $history.Count -eq 0) {
            Write-Warning "Resource '$ResourceId' ($ResourceType) has no configuration history in AWS Config."
            return $null
        }

        Write-Verbose "Retrieved $($history.Count) configuration item(s) for '$ResourceId'."

        # Get the earliest item (last in reverse chronological order)
        # Get the earliest item (last in reverse chronological order)
        $earliestItem = $history | Where-Object ConfigurationItemStatus -eq "ResourceDiscovered"  | Select-Object -First 1
        if (-not $earliestItem) {
            Write-Warning "Resource '$ResourceId' ($ResourceType) has no ResourceDiscovered status in Config history."
            return $null
        }
        $ResourceDiscovered = $true
        $creationDate = $earliestItem.ConfigurationItemCaptureTime

        # Query CloudTrail for the creation event
        $principalName = $null
        $eventName = $null
        $eventSource = $null

        Write-Verbose "Querying CloudTrail for creation event around $creationDate for '$ResourceId'."

        try {
            $lookupAttributes = @(
                @{
                    AttributeKey   = 'ResourceName'
                    AttributeValue = $ResourceId
                }
            )

            $ctEvents = Find-CTEvent -LookupAttribute $lookupAttributes -StartTime $creationDate.AddMinutes(-15) -EndTime $creationDate.AddMinutes(15) @awsParams
        }
        catch {
            $errorMessage = $_.Exception.Message
            if ($errorMessage -match 'AccessDenied|not authorized') {
                Write-Error "Access denied querying CloudTrail for '$ResourceId': $errorMessage"
                return
            }
            # CloudTrail lookup failure is non-fatal — return result with null CT fields
            Write-Verbose "CloudTrail lookup failed for '$ResourceId': $errorMessage"
            $ctEvents = @()
        }

        if ($ctEvents -and $ctEvents.Count -gt 0) {
            Write-Verbose "Found $($ctEvents.Count) CloudTrail event(s) for '$ResourceId'."
            $creationEvent = $ctEvents | Select-Object -First 1
            $principalName = $creationEvent.Username
            $eventName = $creationEvent.EventName
            $eventSource = $creationEvent.EventSource
        }
        else {
            Write-Verbose "No CloudTrail events found for '$ResourceId' around creation time."
        }

        [PSCustomObject][ordered]@{
            ResourceId    = $ResourceId
            ResourceType  = $ResourceType
            CreationDate  = $creationDate
            ResourceDiscovered = $ResourceDiscovered
            PrincipalName = $principalName
            FirstCloudTrailEventName     = $eventName
            FirstCloudTrailEventSource   = $eventSource
        }
    }

    end { }
}

