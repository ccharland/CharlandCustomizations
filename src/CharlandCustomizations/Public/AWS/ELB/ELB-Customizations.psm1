<#
.SYNOPSIS
    Elastic Load Balancing (ALB/NLB) custom functions.
#>
Write-Verbose "Loading ELB-Customizations.psm1"

. "$PSScriptRoot/../../../Private/New-AWSParamSplat.ps1"
. "$PSScriptRoot/../../Test-CHARAWSCmdlet.ps1"

# True when $CoveringName is the same host as $Name, or a single-label wildcard ('*.example.com')
# that covers it. Mirrors how TLS clients match wildcard names (one label only).
$script:TestCertificateNameCoverage = {
  param(
    [Parameter(Mandatory)]
    [string]$CoveringName,

    [Parameter(Mandatory)]
    [string]$Name
  )

  if ($CoveringName -eq $Name) {
    return $true
  }
  if ($CoveringName.StartsWith('*.')) {
    $suffix = [regex]::Escape($CoveringName.Substring(1))
    return [bool]($Name -match "^[^.]+$suffix$")
  }
  $false
}

# Get-ACMCertificateList only returns RSA_2048 certificates unless key types are requested, which
# would hide valid ECDSA or larger-RSA replacements. These are the key types ALB/NLB listeners accept.
$script:ElbSupportedKeyTypes = @(
  'RSA_2048', 'RSA_3072', 'RSA_4096', 'EC_prime256v1', 'EC_secp384r1', 'EC_secp521r1'
)

function Remove-CHARExpiredELBListenerCertificate {
  <#
.SYNOPSIS
  Finds and removes expired ACM certificates from ALB/NLB listeners.

.DESCRIPTION
  Enumerates Application and Network Load Balancers (Elastic Load Balancing v2),
  reads the certificates attached to each secure listener, and looks up each ACM
  certificate's expiration date. Certificates that expired at least -DaysExpired
  days ago are removed from the listener with Remove-ELB2ListenerCertificate.

  The listener's default certificate cannot be removed without replacing it.
  By default, an expired default certificate is reported with the action
  'DefaultCertificate' and a warning, and is not modified.

  With -ReplaceDefaultCertificate, the function looks in the certificate's own
  region (RSA 2048/3072/4096 and ECDSA 256/384/521 key types) for an ISSUED,
  unexpired ACM certificate whose domain name and subject
  alternative names cover every name on the expired certificate (a '*.example.com'
  certificate covers 'www.example.com'). If one certificate has the latest
  expiration date, it becomes the listener's default (Edit-ELB2Listener) and the
  expired certificate is then removed from the listener if it is still attached.
  If there is no match, or two matches tie for the latest expiration, the
  listener is left unchanged and the action is 'NoReplacementFound'.

  Only ACM certificates are evaluated. Certificates from other sources (for
  example IAM server certificates) are skipped with a warning. Classic Load
  Balancers are not covered.

  The certificate itself is not deleted from ACM. Use Remove-CHARExpiredACMCerts
  for that after it is no longer in use.

.PARAMETER LoadBalancerName
  Load balancer name to match. Wildcards are supported. Defaults to '*'.

.PARAMETER DaysExpired
  Minimum number of days a certificate must have been expired before it is
  removed. Defaults to 0 (any expired certificate).

.PARAMETER ReplaceDefaultCertificate
  Replaces an expired default listener certificate with a matching, unexpired
  ACM certificate. Without this switch, expired default certificates are only
  reported.

.PARAMETER Region
    AWS region. If not specified, uses the session default.

.PARAMETER ProfileName
    AWS profile name. Optional.

.PARAMETER AccessKey
    AWS access key. Optional.

.PARAMETER SecretKey
    AWS secret key. Optional.

.PARAMETER SessionToken
    AWS session token for temporary credentials. Optional.

.PARAMETER Credential
    Pre-built AWS credential object. Optional.

.PARAMETER ProfileLocation
    Custom credential file path. Optional.

.PARAMETER EndpointUrl
    Custom AWS service endpoint URL. Optional.

.EXAMPLE
  Remove-CHARExpiredELBListenerCertificate -Region us-east-1 -WhatIf

  Shows which expired certificates would be removed from listeners in us-east-1.

.EXAMPLE
  Remove-CHARExpiredELBListenerCertificate -LoadBalancerName 'prod-*' -DaysExpired 30 -ProfileName production

  Removes certificates that expired more than 30 days ago from listeners on
  load balancers whose names start with 'prod-'.

.EXAMPLE
  Remove-CHARExpiredELBListenerCertificate -ReplaceDefaultCertificate -WhatIf

  Shows which expired certificates would be removed and which expired default
  certificates would be replaced, without changing anything.

.NOTES
    Generated by Kiro using Auto, reviewed by ccharland
    Last updated: November 2026
#>
  [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
  [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSAvoidUsingPlainTextForPassword', 'Credential',
    Justification = 'Credential parameter accepts AWSCredentials object, not a password')]
  [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSAvoidUsingPlainTextForPassword', 'NetworkCredential',
    Justification = 'NetworkCredential typed as [object] for pipeline compatibility')]
  param(
    [Parameter()]
    [ValidateNotNullOrEmpty()]
    [string]$LoadBalancerName = '*',

    [Parameter()]
    [ValidateRange(0, 36500)]
    [int]$DaysExpired = 0,

    [Parameter()]
    [switch]$ReplaceDefaultCertificate,

    [Parameter()]
    [string]$Region,
    [Parameter()]
    [string]$ProfileName,
    [Parameter()]
    [string]$AccessKey,
    [Parameter()]
    [string]$SecretKey,
    [Parameter()]
    [string]$SessionToken,
    [Parameter()]
    [object]$Credential,
    [Parameter()]
    [object]$NetworkCredential,
    [Parameter()]
    [string]$ProfileLocation,
    [Parameter()]
    [string]$EndpointUrl
  )

  begin {
    $null = Test-CHARAWSCmdlet -Name 'Get-ELB2LoadBalancer'
    $null = Test-CHARAWSCmdlet -Name 'Get-ELB2Listener'
    $null = Test-CHARAWSCmdlet -Name 'Get-ELB2ListenerCertificate'
    $null = Test-CHARAWSCmdlet -Name 'Remove-ELB2ListenerCertificate'
    $null = Test-CHARAWSCmdlet -Name 'Get-ACMCertificateDetail'
    if ($ReplaceDefaultCertificate) {
      $null = Test-CHARAWSCmdlet -Name 'Edit-ELB2Listener'
      $null = Test-CHARAWSCmdlet -Name 'Get-ACMCertificateList'
    }

    $awsParams = New-AWSParamSplat -BoundParameters $PSBoundParameters
  }

  process {
    try {
      $now = [DateTime]::UtcNow
      # Many listeners share one certificate, so look each ACM certificate up once.
      $detailCache = @{}
      $issuedListCache = @{}
      $replacementCache = @{}

      # Returns the ACM certificate detail, or $null (with a warning) when it can't be read.
      # A failed lookup must not look like "not expired" or "expired"; callers leave it alone.
      $getCertificateDetail = {
        param([string]$Arn, [string]$CertificateRegion)
        if (-not $detailCache.ContainsKey($Arn)) {
          $acmParams = @{} + $awsParams
          # The ACM lookup must use the certificate's own region, which can differ from -Region.
          $acmParams['Region'] = $CertificateRegion
          try {
            $detailCache[$Arn] = Get-ACMCertificateDetail -CertificateArn $Arn @acmParams -ErrorAction Stop
          }
          catch {
            Write-Warning "Skipping '$Arn': unable to read ACM certificate details. $($_.Exception.Message)"
            $detailCache[$Arn] = $null
          }
        }
        $detailCache[$Arn]
      }

      # Returns the expiration in UTC, or $null when ACM reports none.
      $getExpiration = {
        param($Detail)
        if ($null -ne $Detail.NotAfter -and ([DateTime]$Detail.NotAfter) -gt [DateTime]::MinValue) {
          ([DateTime]$Detail.NotAfter).ToUniversalTime()
        }
      }

      # The API accepts only CertificateArn in request objects; a describe-response object also
      # carries IsDefault, which violates the removal/modify request contract.
      $newCertificateRequest = {
        param([string]$Arn)
        $request = New-Object -TypeName 'Amazon.ElasticLoadBalancingV2.Model.Certificate'
        $request.CertificateArn = $Arn
        $request
      }

      $getCertificateNames = {
        param($Detail)
        @(@($Detail.DomainName) + @($Detail.SubjectAlternativeNames)) |
          Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) } |
          ForEach-Object { ([string]$_).TrimEnd('.').ToLowerInvariant() } |
          Sort-Object -Unique
      }

      # Picks the unexpired ISSUED certificate that covers every name on the expired one and
      # expires last. Returns @{ Arn; Reason }; Arn is $null when there is no safe choice.
      $findReplacement = {
        param([string]$ExpiredArn, [string]$CertificateRegion, $ExpiredDetail)
        if ($replacementCache.ContainsKey($ExpiredArn)) {
          return $replacementCache[$ExpiredArn]
        }

        $requiredNames = @(& $getCertificateNames $ExpiredDetail)
        if ($requiredNames.Count -eq 0) {
          $result = @{ Arn = $null; Reason = 'the expired certificate has no domain names to match' }
        }
        else {
          if (-not $issuedListCache.ContainsKey($CertificateRegion)) {
            $acmParams = @{} + $awsParams
            $acmParams['Region'] = $CertificateRegion
            $issuedListCache[$CertificateRegion] = @(Get-ACMCertificateList -CertificateStatus 'ISSUED' -Includes_KeyType $script:ElbSupportedKeyTypes @acmParams -ErrorAction Stop)
          }

          $candidates = @(foreach ($summary in $issuedListCache[$CertificateRegion]) {
              if ($summary.CertificateArn -eq $ExpiredArn) { continue }
              $candidateDetail = & $getCertificateDetail $summary.CertificateArn $CertificateRegion
              if ($null -eq $candidateDetail) { continue }
              $candidateExpiration = & $getExpiration $candidateDetail
              if ($null -eq $candidateExpiration -or $candidateExpiration -le $now) { continue }

              $candidateNames = @(& $getCertificateNames $candidateDetail)
              $uncovered = @($requiredNames | Where-Object {
                  $name = $_
                  -not ($candidateNames | Where-Object { & $script:TestCertificateNameCoverage -CoveringName $_ -Name $name })
                })
              if ($uncovered.Count -eq 0) {
                [PSCustomObject]@{ Arn = $summary.CertificateArn; NotAfter = $candidateExpiration }
              }
            })

          $ranked = @($candidates | Sort-Object NotAfter -Descending)
          if ($ranked.Count -eq 0) {
            $result = @{ Arn = $null; Reason = 'no unexpired ISSUED ACM certificate covers all of its names' }
          }
          elseif ($ranked.Count -gt 1 -and $ranked[0].NotAfter -eq $ranked[1].NotAfter) {
            $result = @{ Arn = $null; Reason = 'multiple matching certificates tie for the latest expiration' }
          }
          else {
            $result = @{ Arn = $ranked[0].Arn; Reason = $null }
          }
        }
        $replacementCache[$ExpiredArn] = $result
        $result
      }

      $loadBalancers = @(Get-ELB2LoadBalancer @awsParams -ErrorAction Stop |
          Where-Object { $_.LoadBalancerName -like $LoadBalancerName })

      foreach ($loadBalancer in $loadBalancers) {
        $listeners = @(Get-ELB2Listener -LoadBalancerArn $loadBalancer.LoadBalancerArn @awsParams -ErrorAction Stop)

        foreach ($listener in $listeners) {
          # HTTP/TCP/UDP listeners have no certificates; skip the extra API call.
          if ([string]$listener.Protocol -notin 'HTTPS', 'TLS') {
            continue
          }

          # The API can return the default certificate twice (IsDefault true and false). Collapse by
          # ARN and keep the default flag, or the non-default copy would bypass the default guard.
          $listenerCertificates = @(
            @(Get-ELB2ListenerCertificate -ListenerArn $listener.ListenerArn @awsParams -ErrorAction Stop) |
              Group-Object -Property CertificateArn |
              ForEach-Object {
                [PSCustomObject]@{
                  CertificateArn = $_.Name
                  IsDefault      = [bool]($_.Group | Where-Object { $_.IsDefault } | Select-Object -First 1)
                }
              }
          )

          foreach ($listenerCertificate in $listenerCertificates) {
            $certificateArn = $listenerCertificate.CertificateArn

            if ($certificateArn -notmatch '^arn:[^:]+:acm:([^:]+):') {
              Write-Warning "Skipping '$certificateArn' on listener '$($listener.ListenerArn)': not an ACM certificate."
              continue
            }
            # The ACM lookup must use the certificate's own region, which can differ from -Region.
            $certificateRegion = $Matches[1]

            $detail = & $getCertificateDetail $certificateArn $certificateRegion
            if ($null -eq $detail) {
              continue
            }
            $notAfter = & $getExpiration $detail
            if ($null -eq $notAfter) {
              continue
            }

            $daysSinceExpired = [int][Math]::Floor(($now - $notAfter).TotalDays)
            if ($notAfter -ge $now -or $daysSinceExpired -lt $DaysExpired) {
              continue
            }

            $action = 'Removed'
            $replacementArn = $null
            if ($listenerCertificate.IsDefault -and -not $ReplaceDefaultCertificate) {
              $action = 'DefaultCertificate'
              Write-Warning "Expired certificate '$certificateArn' is the default certificate for listener '$($listener.ListenerArn)'. Use -ReplaceDefaultCertificate or replace it with Edit-ELB2Listener."
            }
            elseif ($listenerCertificate.IsDefault) {
              $replacement = & $findReplacement $certificateArn $certificateRegion $detail
              $replacementArn = $replacement.Arn
              if ($null -eq $replacementArn) {
                $action = 'NoReplacementFound'
                Write-Warning "Expired default certificate '$certificateArn' on listener '$($listener.ListenerArn)' was not replaced: $($replacement.Reason)."
              }
              elseif ($PSCmdlet.ShouldProcess($listener.ListenerArn, "Replace expired default certificate '$certificateArn' with '$replacementArn'")) {
                $null = Edit-ELB2Listener -ListenerArn $listener.ListenerArn -Certificate (& $newCertificateRequest $replacementArn) -Force @awsParams -ErrorAction Stop

                # Whether the old default stays attached as a non-default certificate isn't guaranteed,
                # so re-read the listener and remove it if it is still there.
                $remainingCertificate = @(Get-ELB2ListenerCertificate -ListenerArn $listener.ListenerArn @awsParams -ErrorAction Stop) |
                  Where-Object { $_.CertificateArn -eq $certificateArn -and -not $_.IsDefault } |
                  Select-Object -First 1
                if ($remainingCertificate) {
                  Remove-ELB2ListenerCertificate -ListenerArn $listener.ListenerArn -Certificate (& $newCertificateRequest $certificateArn) -Force @awsParams -ErrorAction Stop
                }
                $action = 'DefaultReplaced'
              }
              else {
                $action = 'Skipped'
              }
            }
            elseif ($PSCmdlet.ShouldProcess($listener.ListenerArn, "Remove certificate '$certificateArn' expired $daysSinceExpired day(s) ago")) {
              Remove-ELB2ListenerCertificate -ListenerArn $listener.ListenerArn -Certificate (& $newCertificateRequest $certificateArn) -Force @awsParams -ErrorAction Stop
            }
            else {
              $action = 'Skipped'
            }

            [PSCustomObject]@{
              LoadBalancerName = $loadBalancer.LoadBalancerName
              ListenerArn      = $listener.ListenerArn
              Port             = $listener.Port
              Protocol         = [string]$listener.Protocol
              CertificateArn   = $certificateArn
              IsDefault        = [bool]$listenerCertificate.IsDefault
              ReplacementCertificateArn = $replacementArn
              NotAfter         = $notAfter
              DaysSinceExpired = $daysSinceExpired
              Action           = $action
            }
          }
        }
      }
    }
    catch {
      $PSCmdlet.ThrowTerminatingError($_)
    }
  }
}

