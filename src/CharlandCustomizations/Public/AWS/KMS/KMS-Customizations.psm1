<#
.SYNOPSIS
    Read-only AWS KMS key audit functions.

.DESCRIPTION
    Provides functions for auditing AWS KMS keys: finding the resources that
    reference a key (via AWS Config), reporting the last successful cryptographic
    use of a key, and finding key policies that reference deleted IAM principals.

    All functions are read-only. None of them establishes that a key is safe to
    delete; empty results are only absence of evidence.

.NOTES
    Generated by Copilot, reviewed by ccharland
    Created: November 2026
#>
Write-Verbose "Loading KMS-Customizations.psm1"

. "$PSScriptRoot/../../../Private/New-AWSParamSplat.ps1"
. "$PSScriptRoot/../../Test-CHARAWSCmdlet.ps1"
# Nested modules have their own scope, so load the KMS private helpers here (not exported).
. "$PSScriptRoot/../../../Private/KMSPrivateFunctions.ps1"

function Find-CHARKMSKeyResource {
    <#
    .SYNOPSIS
        Lists AWS Config-recorded resources whose encryption configuration references a KMS key.

    .DESCRIPTION
        Resolves the supplied key ARN to its key ID and aliases, then queries AWS Config
        (Select-CFGResourceConfig) for recorded resources whose configuration contains a
        value equal to the key ARN, the key ID, an alias name, or an alias ARN.

        Resources are never inspected directly: only the Config-recorded configuration
        items are matched. Results are therefore limited to resource types that AWS Config
        records in the queried region, and to the encryption properties that Config
        captures for them. Only the region of the key (or -Region) is queried.

        IMPORTANT: an empty result does NOT establish that a key is safe to delete. Config
        may not record a resource type, resources in other regions or accounts are not
        queried, and some services reference keys through grants or outside Config.

    .PARAMETER KeyArn
        ARN of the KMS key, 'arn:aws:kms:<region>:<account-id>:key/<key-id>'. Mandatory.
        Accepts pipeline input by value and by property name; alias 'Arn'.

    .PARAMETER Region
        AWS region. Defaults to the region in the key ARN.

    .PARAMETER ProfileName
        AWS profile name. Optional.

    .PARAMETER AccessKey
        AWS access key. Optional.

    .PARAMETER SecretKey
        AWS secret key. Optional.

    .PARAMETER SessionToken
        AWS session token for temporary credentials. Optional.

    .PARAMETER Credential
        Pre-built AWS credential object. Optional.

    .PARAMETER ProfileLocation
        Custom credential file path. Optional.

    .PARAMETER EndpointUrl
        Custom AWS service endpoint URL. Optional.

    .INPUTS
        System.String
            A KMS key ARN, by value or by the 'KeyArn'/'Arn' property name.

    .OUTPUTS
        PSCustomObject (PSTypeName 'AWS.KMS.KeyResource') with properties:
            KeyArn          - The audited key ARN
            ResourceType    - AWS Config resource type (for example AWS::EC2::Volume)
            ResourceId      - The resource ID
            ResourceArn     - The resource ARN, when recorded
            ResourceRegion  - The resource region
            AccountId       - The resource account
            MatchedProperty - The configuration property holding the key reference
            MatchedOn       - What matched: 'KeyArn', 'KeyId', 'AliasName' or 'AliasArn'
            MatchedValue    - The value found in the configuration

    .EXAMPLE
        Find-CHARKMSKeyResource -KeyArn 'arn:aws:kms:us-east-1:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab' -ProfileName audit

        Lists Config-recorded resources in us-east-1 that reference the key.

    .NOTES
        Generated by Copilot, reviewed by ccharland
        Created: November 2026
        Requires AWS Config recording of the relevant resource types.

    .LINK
        https://docs.aws.amazon.com/config/latest/developerguide/querying-AWS-resources.html
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory, Position = 0, ValueFromPipeline, ValueFromPipelineByPropertyName)]
        [ValidateNotNullOrEmpty()]
        [Alias('Arn')]
        [string]$KeyArn,

        [Parameter()]
        [string]$Region,

        [Parameter()]
        [string]$ProfileName,

        [Parameter()]
        [string]$AccessKey,

        [Parameter()]
        [string]$SecretKey,

        [Parameter()]
        [string]$SessionToken,

        [Parameter()]
        [object]$Credential,

        [Parameter()]
        [string]$ProfileLocation,

        [Parameter()]
        [string]$EndpointUrl
    )

    begin {
        @('Get-KMSAliasList', 'Select-CFGResourceConfig') | Test-CHARAWSCmdlet | Out-Null
    }

    process {
        $key = Resolve-CHARKMSKeyArn -KeyArn $KeyArn

        # Copy so a per-key region default never leaks into the next piped key.
        $callParams = [System.Collections.Generic.Dictionary[string, object]]::new($PSBoundParameters)
        if (-not $callParams.ContainsKey('Region')) { $callParams['Region'] = $key.Region }
        $awsParams = New-AWSParamSplat -BoundParameters $callParams

        # Every identifier a resource's encryption configuration might use for this key.
        $identifiers = @{}
        $identifiers[$KeyArn] = 'KeyArn'
        $identifiers[$key.KeyId] = 'KeyId'

        Write-Verbose "Listing aliases for key $($key.KeyId)"
        foreach ($alias in @(Get-KMSAliasList -KeyId $key.KeyId @awsParams)) {
            if ($alias.AliasName) { $identifiers[$alias.AliasName] = 'AliasName' }
            if ($alias.AliasArn) { $identifiers[$alias.AliasArn] = 'AliasArn' }
        }

        # Select only identity columns plus the whole configuration block; the key
        # reference is matched client-side because the property name differs per type.
        $expression = 'SELECT resourceId, resourceType, arn, awsRegion, accountId, configuration'
        Write-Verbose "Querying AWS Config: $expression"
        $rows = @(Select-CFGResourceConfig -Expression $expression @awsParams)

        $seen = @{}
        foreach ($row in $rows) {
            if ($null -eq $row) { continue }
            $item = if ($row -is [string]) { $row | ConvertFrom-Json } else { $row }

            foreach ($hit in @(Get-CHARKMSConfigStringValue -InputObject $item.configuration -Path 'configuration')) {
                $matchedOn = $identifiers.Keys | Where-Object { $_ -ieq $hit.Value } | Select-Object -First 1
                if (-not $matchedOn) { continue }

                $dedupKey = "$($item.resourceType)|$($item.resourceId)|$($hit.Path)|$matchedOn"
                if ($seen.ContainsKey($dedupKey)) { continue }
                $seen[$dedupKey] = $true

                [PSCustomObject]@{
                    PSTypeName      = 'AWS.KMS.KeyResource'
                    KeyArn          = $KeyArn
                    ResourceType    = $item.resourceType
                    ResourceId      = $item.resourceId
                    ResourceArn     = $item.arn
                    ResourceRegion  = $item.awsRegion
                    AccountId       = $item.accountId
                    MatchedProperty = $hit.Path
                    MatchedOn       = $identifiers[$matchedOn]
                    MatchedValue    = $hit.Value
                }
            }
        }
    }
}

function Get-CHARKMSKeyLastUsage {
    <#
    .SYNOPSIS
        Reports the last successful cryptographic use of a KMS key.

    .DESCRIPTION
        Calls the KMS GetKeyLastUsage API (Get-KMSKeyLastUsage) and combines the last
        usage record with the key creation date and the date KMS began tracking usage to
        report how reliable the answer is. UsageStatus is:

          Observed               - a successful cryptographic operation was recorded.
          NeverUsedSinceCreation - nothing recorded and the key was created on or after
                                   the tracking start date.
          IncompleteHistory      - nothing recorded, but the key predates tracking, so it
                                   may have been used earlier. Check older CloudTrail logs.

        IMPORTANT: this does NOT establish that a key is safe to delete. Infrequent
        workflows may depend on the key. Disable the key first and watch CloudTrail for
        DisabledException events before scheduling deletion.

    .PARAMETER KeyArn
        ARN of the KMS key, 'arn:aws:kms:<region>:<account-id>:key/<key-id>'. Mandatory.
        Accepts pipeline input by value and by property name; alias 'Arn'.

    .PARAMETER Region
        AWS region. Defaults to the region in the key ARN.

    .PARAMETER ProfileName
        AWS profile name. Optional.

    .PARAMETER AccessKey
        AWS access key. Optional.

    .PARAMETER SecretKey
        AWS secret key. Optional.

    .PARAMETER SessionToken
        AWS session token for temporary credentials. Optional.

    .PARAMETER Credential
        Pre-built AWS credential object. Optional.

    .PARAMETER ProfileLocation
        Custom credential file path. Optional.

    .PARAMETER EndpointUrl
        Custom AWS service endpoint URL. Optional.

    .INPUTS
        System.String
            A KMS key ARN, by value or by the 'KeyArn'/'Arn' property name.

    .OUTPUTS
        PSCustomObject (PSTypeName 'AWS.KMS.KeyLastUsage') with properties:
            KeyArn            - The key ARN
            KeyId             - The key ID
            KeyCreationDate   - When the key was created
            TrackingStartDate - When KMS began recording usage for the key
            LastUsedOperation - The last recorded operation, or $null
            LastUsedTimestamp - When it happened, or $null
            CloudTrailEventId - The CloudTrail event ID of that operation, or $null
            UsageStatus       - 'Observed', 'NeverUsedSinceCreation' or 'IncompleteHistory'

    .EXAMPLE
        Get-CHARKMSKeyLastUsage -KeyArn 'arn:aws:kms:us-east-1:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab' -ProfileName audit

        Reports the last recorded cryptographic use of the key and how complete the history is.

    .NOTES
        Generated by Copilot, reviewed by ccharland
        Created: November 2026

    .LINK
        https://docs.aws.amazon.com/kms/latest/APIReference/API_GetKeyLastUsage.html
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory, Position = 0, ValueFromPipeline, ValueFromPipelineByPropertyName)]
        [ValidateNotNullOrEmpty()]
        [Alias('Arn')]
        [string]$KeyArn,

        [Parameter()]
        [string]$Region,

        [Parameter()]
        [string]$ProfileName,

        [Parameter()]
        [string]$AccessKey,

        [Parameter()]
        [string]$SecretKey,

        [Parameter()]
        [string]$SessionToken,

        [Parameter()]
        [object]$Credential,

        [Parameter()]
        [string]$ProfileLocation,

        [Parameter()]
        [string]$EndpointUrl
    )

    begin {
        @('Get-KMSKeyLastUsage') | Test-CHARAWSCmdlet | Out-Null
    }

    process {
        $key = Resolve-CHARKMSKeyArn -KeyArn $KeyArn

        # Copy so a per-key region default never leaks into the next piped key.
        $callParams = [System.Collections.Generic.Dictionary[string, object]]::new($PSBoundParameters)
        if (-not $callParams.ContainsKey('Region')) { $callParams['Region'] = $key.Region }
        $awsParams = New-AWSParamSplat -BoundParameters $callParams

        $response = Get-KMSKeyLastUsage -KeyId $key.KeyId @awsParams -ErrorAction Stop
        $usage = $response.KeyLastUsage
        $hasUsage = $null -ne $usage -and $null -ne $usage.Timestamp -and $usage.Timestamp -ne [datetime]::MinValue

        $status = if ($hasUsage) {
            'Observed'
        }
        elseif ($response.TrackingStartDate -and $response.KeyCreationDate -and
            $response.KeyCreationDate -ge $response.TrackingStartDate) {
            'NeverUsedSinceCreation'
        }
        else {
            'IncompleteHistory'
        }

        [PSCustomObject]@{
            PSTypeName        = 'AWS.KMS.KeyLastUsage'
            KeyArn            = $KeyArn
            KeyId             = $key.KeyId
            KeyCreationDate   = $response.KeyCreationDate
            TrackingStartDate = $response.TrackingStartDate
            LastUsedOperation = if ($hasUsage) { [string]$usage.Operation } else { $null }
            LastUsedTimestamp = if ($hasUsage) { $usage.Timestamp } else { $null }
            CloudTrailEventId = if ($hasUsage) { $usage.CloudTrailEventId } else { $null }
            UsageStatus       = $status
        }
    }
}

function Find-CHARDeletedPrincipalKMSPolicy {
    <#
    .SYNOPSIS
        Finds KMS key policies that reference deleted IAM principals.

    .DESCRIPTION
        Retrieves the default key policy of one KMS key (-KeyArn) or of every
        customer-managed key in the region (when -KeyArn is omitted) and reports
        Principal entries that are AWS unique IDs (AIDA, AROA, AGPA, AIPA, ASCA, APKA
        prefixes) instead of ARNs. IAM leaves the unique ID behind when the referenced
        user, role or group is deleted.

        Only the Principal element is examined; principals named in Condition keys are
        not. AWS-managed keys are skipped because their policies cannot be edited.
        Without -KeyArn only the selected region is scanned.

    .PARAMETER KeyArn
        ARN of one KMS key to audit. Optional; when omitted every customer-managed key in
        the region is audited. Accepts pipeline input by value and by property name;
        alias 'Arn'.

    .PARAMETER Region
        AWS region. Defaults to the region in the key ARN when -KeyArn is supplied;
        otherwise your default region.

    .PARAMETER ProfileName
        AWS profile name. Optional.

    .PARAMETER AccessKey
        AWS access key. Optional.

    .PARAMETER SecretKey
        AWS secret key. Optional.

    .PARAMETER SessionToken
        AWS session token for temporary credentials. Optional.

    .PARAMETER Credential
        Pre-built AWS credential object. Optional.

    .PARAMETER ProfileLocation
        Custom credential file path. Optional.

    .PARAMETER EndpointUrl
        Custom AWS service endpoint URL. Optional.

    .INPUTS
        System.String
            A KMS key ARN, by value or by the 'KeyArn'/'Arn' property name.

    .OUTPUTS
        PSCustomObject (PSTypeName 'AWS.KMS.DeletedPrincipalKeyPolicy') with properties:
            KeyArn           - The key ARN
            KeyId            - The key ID
            PolicyName       - The policy name ('default')
            Statement        - The statement Sid or 'Statement[<index>]'
            DeletedPrincipal - The unresolved principal unique ID

    .EXAMPLE
        Find-CHARDeletedPrincipalKMSPolicy -KeyArn 'arn:aws:kms:us-east-1:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab' -ProfileName audit

        Reports unresolved principal IDs in the key's policy.

    .EXAMPLE
        Find-CHARDeletedPrincipalKMSPolicy -Region us-west-2 -ProfileName audit

        Audits every customer-managed key policy in us-west-2.

    .NOTES
        Generated by Copilot, reviewed by ccharland
        Created: November 2026

    .LINK
        https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_identifiers.html
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Position = 0, ValueFromPipeline, ValueFromPipelineByPropertyName)]
        [ValidateNotNullOrEmpty()]
        [Alias('Arn')]
        [string]$KeyArn,

        [Parameter()]
        [string]$Region,

        [Parameter()]
        [string]$ProfileName,

        [Parameter()]
        [string]$AccessKey,

        [Parameter()]
        [string]$SecretKey,

        [Parameter()]
        [string]$SessionToken,

        [Parameter()]
        [object]$Credential,

        [Parameter()]
        [string]$ProfileLocation,

        [Parameter()]
        [string]$EndpointUrl
    )

    begin {
        @('Get-KMSKeyPolicy', 'Get-KMSKeyList', 'Get-KMSKey') | Test-CHARAWSCmdlet | Out-Null
    }

    process {
        if ($PSBoundParameters.ContainsKey('KeyArn')) {
            $resolved = Resolve-CHARKMSKeyArn -KeyArn $KeyArn
            $callParams = [System.Collections.Generic.Dictionary[string, object]]::new($PSBoundParameters)
            if (-not $callParams.ContainsKey('Region')) { $callParams['Region'] = $resolved.Region }
            $awsParams = New-AWSParamSplat -BoundParameters $callParams
            $targets = @([PSCustomObject]@{ KeyId = $resolved.KeyId; KeyArn = $KeyArn })
        }
        else {
            $awsParams = New-AWSParamSplat -BoundParameters $PSBoundParameters
            $targets = foreach ($entry in @(Get-KMSKeyList @awsParams)) {
                try {
                    $meta = Get-KMSKey -KeyId $entry.KeyId @awsParams -ErrorAction Stop
                }
                catch {
                    Write-Warning "Failed to describe key $($entry.KeyId): $_"
                    continue
                }
                if ("$($meta.KeyManager)" -ne 'CUSTOMER') { continue }
                [PSCustomObject]@{ KeyId = $entry.KeyId; KeyArn = $entry.KeyArn }
            }
        }

        foreach ($target in @($targets)) {
            Write-Verbose "Checking key policy: $($target.KeyId)"
            try {
                $policyText = Get-KMSKeyPolicy -KeyId $target.KeyId -PolicyName 'default' @awsParams -ErrorAction Stop
                $policy = $policyText | ConvertFrom-Json
            }
            catch {
                Write-Warning "Failed to retrieve or parse the policy for key $($target.KeyId): $_"
                continue
            }

            $statements = @($policy.Statement)
            for ($i = 0; $i -lt $statements.Count; $i++) {
                $principal = $statements[$i].Principal
                if ($null -eq $principal -or $principal -is [string]) { continue }

                $statementId = if ($statements[$i].Sid) { $statements[$i].Sid } else { "Statement[$i]" }
                foreach ($value in @($principal.AWS)) {
                    if ($value -is [string] -and $value -cmatch $script:DeletedPrincipalIdPattern) {
                        [PSCustomObject]@{
                            PSTypeName       = 'AWS.KMS.DeletedPrincipalKeyPolicy'
                            KeyArn           = $target.KeyArn
                            KeyId            = $target.KeyId
                            PolicyName       = 'default'
                            Statement        = $statementId
                            DeletedPrincipal = $value
                        }
                    }
                }
            }
        }
    }
}

Export-ModuleMember -Function @(
    'Find-CHARDeletedPrincipalKMSPolicy',
    'Find-CHARKMSKeyResource',
    'Get-CHARKMSKeyLastUsage'
)
